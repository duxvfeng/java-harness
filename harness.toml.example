# Harness Configuration File
# Generated by Harness System

[harness]
version = "5.0.0"
backend = "claude"  # Options: claude, codex, cursor, auto
project_root = "."

# ============================================
# 端到端检测配置 (Task 12.4+ - 自动触发机制)
# ============================================
[e2e_detection]
# 端到端检测总开关
enabled = true
# 运行模式: strict | lenient
mode = "strict"
# 单次测试超时时间（秒）
timeout = 120
# 检测失败时是否重试
retry_on_failure = true
# 最大重试次数
max_retries = 3

# 自动修复配置
[e2e_detection.auto_fix]
# 是否启用自动修复
enabled = true
# 最大修复迭代次数
max_iterations = 3
# 单次修复超时（秒）
fix_timeout = 60
# 修复后是否自动提交
commit_on_fix = true

# 支持的修复类型
[e2e_detection.auto_fix.types]
# 依赖包更新
dependency_update = true
# 敏感文件保护
gitignore_add = true
# 代码自动修复
code_fix = false
# 测试自动生成
test_generation = false

# ============================================
# 测试类型配置
# ============================================

# 前端功能测试
[e2e_detection.test_types.frontend]
# 是否启用前端测试
enabled = true
# 测试框架: auto | playwright | cypress | selenium
framework = "playwright"

# Playwright 配置
[e2e_detection.test_types.frontend.playwright]
# 测试超时（毫秒）
timeout = 30000
# 断言超时（毫秒）
expect_timeout = 5000
# 是否无头模式
headless = true
# 视口大小
viewport_width = 1280
viewport_height = 720

# 浏览器配置
browsers = ["chromium", "firefox", "webkit"]
# 并行工作进程数（null 表示自动）
workers = null
# 失败重试次数
retries = 1

# 功能特性
[e2e_detection.test_types.frontend.playwright.features]
# 自动等待机制
auto_wait = true
# 失败时录制视频
video_recording = "retain-on-failure"
# 失败时截图
screenshot = "only-on-failure"
# 失败时保存追踪
trace = "retain-on-failure"

# Cypress 配置（备用）
[e2e_detection.test_types.frontend.cypress]
command = "npx cypress run"
config_file = "cypress.config.js"
timeout = 120000

# 后端API测试
[e2e_detection.test_types.backend]
enabled = true
framework = "auto"
test_paths = ["backend/tests/", "src/test/api/", "test/"]

# 支持的后端框架
[e2e_detection.test_types.backend.nodejs]
command = "npm test"
config_files = ["package.json"]

[e2e_detection.test_types.backend.java]
# Maven 项目
command = "mvn test"
config_file = "pom.xml"
# Gradle 项目（备选）
command_alt = "./gradlew test"
config_file_alt = "build.gradle"

[e2e_detection.test_types.backend.python]
command = "pytest"
config_files = ["pytest.ini", "setup.cfg"]
virtual_env = "venv"

[e2e_detection.test_types.backend.go]
command = "go test ./..."
config_files = ["go.mod"]

# 集成测试
[e2e_detection.test_types.integration]
enabled = true
# 测试场景列表
test_scenarios = ["user_login", "data_flow", "error_handling", "ui_interaction"]

# 用户登录场景
[e2e_detection.test_types.integration.scenarios.user_login]
description = "用户登录流程集成测试"
timeout = 30
components = ["frontend_login", "backend_auth", "session_management"]
playwright_tests = ["e2e/login.spec.ts"]

# 数据流转场景
[e2e_detection.test_types.integration.scenarios.data_flow]
description = "数据流转集成测试"
timeout = 60
components = ["api_request", "data_processing", "response_handling"]
playwright_tests = ["e2e/data-flow.spec.ts"]

# 错误处理场景
[e2e_detection.test_types.integration.scenarios.error_handling]
description = "错误处理集成测试"
timeout = 30
components = ["frontend_validation", "backend_error_handling", "user_feedback"]
playwright_tests = ["e2e/error-handling.spec.ts"]

# UI交互场景
[e2e_detection.test_types.integration.scenarios.ui_interaction]
description = "用户界面交互测试"
timeout = 45
components = ["button_clicks", "form_submissions", "navigation"]
playwright_tests = ["e2e/ui-interaction.spec.ts"]

# 性能测试
[e2e_detection.test_types.performance]
enabled = false
# 最大响应时间（毫秒）
response_time_max = 2000
# 警告响应时间（毫秒）
response_time_warning = 1500
# 并发用户数
concurrent_users = 10

# 资源使用阈值
[e2e_detection.test_types.performance.thresholds]
memory_usage_max = 0.8  # 80%
cpu_usage_max = 0.9      # 90%

# 性能测试工具
[e2e_detection.test_types.performance.tools]
# Lighthouse
[e2e_detection.test_types.performance.tools.lighthouse]
command = "npx lighthouse"
config_file = "lighthouse.config.js"
# JMeter
[e2e_detection.test_types.performance.tools.jmeter]
command = "jmeter -n -t"
config_file = "test-plan.jmx"
# k6
[e2e_detection.test_types.performance.tools.k6]
command = "k6 run"
config_file = "load-test.js"

# 安全测试
[e2e_detection.test_types.security]
enabled = true
# 扫描安全漏洞
scan_vulnerabilities = true
# 检查依赖安全性
check_dependencies = true
# 扫描敏感信息
scan_secrets = true

# 安全工具配置
[e2e_detection.test_types.security.tools]
# npm audit
[e2e_detection.test_types.security.tools.npm_audit]
command = "npm audit --json"
enabled = true
# safety (Python)
[e2e_detection.test_types.security.tools.safety]
command = "safety check"
enabled = true
# OWASP Dependency Check
[e2e_detection.test_types.security.tools.owasp_dependency_check]
command = "dependency-check"
enabled = false
# gitleaks
[e2e_detection.test_types.security.tools.git_leak]
command = "gitleaks detect"
enabled = false

# 敏感文件模式
[e2e_detection.test_types.security.sensitive_patterns]
patterns = [
  "*.pem",
  "*.key",
  ".env*",
  "secrets/**",
  "*credentials*",
  "*password*",
  "id_rsa",
  "*.jwt"
]

# ============================================
# 阈值配置
# ============================================
[e2e_detection.thresholds]
# 响应时间阈值
[e2e_detection.thresholds.response_time]
warning = 1500    # 毫秒
critical = 2000   # 毫秒
description = "响应时间阈值"

# 内存使用阈值
[e2e_detection.thresholds.memory_usage]
warning = 0.7     # 70%
critical = 0.8    # 80%
description = "内存使用率阈值"

# CPU使用阈值
[e2e_detection.thresholds.cpu_usage]
warning = 0.8     # 80%
critical = 0.9    # 90%
description = "CPU使用率阈值"

# 并发用户数
[e2e_detection.thresholds.concurrent_users]
min = 10
recommended = 50
description = "并发用户数支持"

# 错误率阈值
[e2e_detection.thresholds.error_rate]
warning = 0.01   # 1%
critical = 0.05  # 5%
description = "错误率阈值"

# Playwright 特定阈值
[e2e_detection.thresholds.playwright_metrics]
test_timeout = 30000         # 30秒
action_timeout = 5000        # 5秒
navigation_timeout = 30000  # 30秒
max_flaky_tests = 0          # 不允许不稳定测试
description = "Playwright 特定阈值"

# ============================================
# 触发器配置
# ============================================
[e2e_detection.triggers]
# 审查通过时自动触发
auto_trigger_on_review_pass = true
# 要求干净的工作空间
require_clean_workspace = true
# 跳过草稿 PR
skip_on_draft_pr = true
# 跳过 WIP 分支
skip_on_wip_branch = true

# 分支模式匹配
[e2e_detection.triggers.branch_patterns]
# 包含的分支模式
include = ["feature/*", "bugfix/*", "hotfix/*"]
# 排除的分支模式
exclude = ["draft/*", "wip/*", "experimental/*"]

# ============================================
# 报告配置
# ============================================
[e2e_detection.reporting]
# 是否生成报告
generate_report = true
# 报告格式: markdown | json | html | console
report_format = "markdown"
# 是否包含详细信息
include_details = true
# 是否保存测试产物
save_artifacts = true
# 产物保存位置
artifacts_location = ".claude/artifacts/e2e-detection/"

# Playwright 报告配置
[e2e_detection.reporting.playwright_reports]
# HTML 报告
html_report = true
# 追踪文件策略
trace_files = "retain-on-failure"
# 截图策略
screenshots = "only-on-failure"
# 视频策略
video_files = "retain-on-failure"

# ============================================
# 系统集成配置
# ============================================
[e2e_detection.integration]
# 与 harness-work 集成
[e2e_detection.integration.harness_work]
enabled = true
# 触发点: after_review | before_complete
trigger_point = "after_review"
# 是否阻塞完成流程
blocking = true

# 与 harness-review 集成
[e2e_detection.integration.harness_review]
enabled = true
# 是否发送反馈
send_feedback = true

# CI 集成
[e2e_detection.integration.ci_integration]
enabled = false
# 平台: github | gitlab | bitbucket
platform = "github"
# 是否在 PR 中评论
comment_on_pr = true

# ============================================
# 高级配置
# ============================================
[e2e_detection.advanced]
# 并行执行
parallel_execution = true
# 最大并行工作进程数
max_parallel_workers = 3
# 缓存测试结果
cache_test_results = true
# 缓存有效期（秒）
cache_ttl = 3600
# 测试后清理
cleanup_after_test = true
# 快速失败模式
fail_fast = false
# 失败时继续
continue_on_failure = true
# 调试模式
debug_mode = false
# 日志级别
log_level = "info"  # trace | debug | info | warn | error

# Playwright 高级配置
[e2e_detection.advanced.playwright_advanced]
# 是否使用 DevTools
dev_tools = false
# 失败时截图
screenshot_on_failure = true
# 失败时录制视频
video_on_failure = true
# 失败时保存追踪
trace_on_failure = true
# 浏览器优先级
browsers_order = ["chromium", "firefox", "webkit"]

# ============================================
# 传统配置（保持兼容性）
# ============================================

# [plan]
# plan_file = "Plans.md"
# spec_file = "spec.md"

# [review]
# auto_review = true
# review_mode = "strict"
# max_iterations = 3

# [work]
# mode = "auto"
# backend = "claude"
# branch_isolation = false

# [logging]
# level = "INFO"
# file = ".claude/logs/harness.log"

# [session]
# session_file = ".claude/state/session.jsonl"
# work_file = ".claude/state/work.jsonl"