{
  "name": "java-harness-market",
  "owner": {
    "name": "dxf",
    "email": "395781596@qq.com"
  },
  "metadata": {
    "description": "Java implementation of Claude Code Harness with Hook protocol and Guardrail support",
    "version": "4.0.0"
  },
  "plugins": [
    {
      "id": "java-harness",
      "name": "Java Harness",
      "version": "4.0.0",
      "description": "Full Java implementation of Claude Code Harness - Plan → Work → Review → Release workflow",
      "author": {
        "name": "dxf",
        "email": "395781596@qq.com"
      },
      "source": {
        "source": "url",
        "url": "https://gitee.com/duxvfeng/java-harness.git"
      },
      "install": "mvn clean package -Pnative -pl java-harness-cli -DskipTests && cp java-harness-cli/target/harness ./",
      "executable": "harness",
      "skills": [
        "skills/harness-plan",
        "skills/harness-work",
        "skills/harness-review",
        "skills/harness-release",
        "skills/harness-plan-brief",
        "skills/harness-loop",
        "skills/breezing"
      ],
      "hooks": ".claude-plugin/hooks.json",
      "workflows": "workflows/",
      "permissions": {
        "allow": [
          "Bash(git status:*)",
          "Bash(mvn -version)",
          "Bash(java -version)",
          "Read(*)",
          "Write(*)"
        ],
        "deny": [
          "Bash(rm -rf *)"
        ]
      }
    }
  ]
}