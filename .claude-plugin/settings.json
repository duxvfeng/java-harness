{
  "agent" : "claude-opus-5",
  "$schema" : "https://json.schemastore.org/claude-code-settings.json",
  "permissions" : {
    "allow" : [ "Bash(git status:*)", "Bash(mvn -version)" ],
    "deny" : [ "Bash(rm -rf *)" ]
  },
  "sandbox" : {
    "failIfUnavailable" : true,
    "network" : {
      "deniedDomains" : [ "169.254.169.254", "metadata.google.internal" ]
    }
  },
  "env" : {
    "JAVA_HOME" : "/usr/lib/jvm/java-17",
    "MAVEN_OPTS" : "-Xmx1G -Xms512m -XX:MaxMetaspaceSize=512m -XX:ReservedCodeCacheSize=256m"
  }
}