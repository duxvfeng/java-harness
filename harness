#!/bin/bash
# Java Harness 主脚本包装器
# 从项目任何位置调用 scripts 目录下的脚本

set -e

# 检测项目根目录
detect_project_root() {
    local current_dir="$(pwd)"
    local dir="$current_dir"

    # 向上查找包含 pom.xml 和 scripts 目录的根目录
    while [ "$dir" != "/" ]; do
        if [ -f "$dir/pom.xml" ] && [ -d "$dir/scripts" ]; then
            echo "$dir"
            return 0
        fi
        dir="$(dirname "$dir")"
    done

    # 如果找不到，尝试从当前脚本位置推导
    if [ -f "$0" ]; then
        local script_dir="$(cd "$(dirname "$0")" && pwd)"
        if [ -f "$script_dir/pom.xml" ]; then
            echo "$script_dir"
            return 0
        fi
    fi

    # 最后回退到当前目录
    echo "$current_dir"
    return 0
}

PROJECT_ROOT="$(detect_project_root)"
SCRIPTS_DIR="$PROJECT_ROOT/scripts"

# 检查脚本目录是否存在
if [ ! -d "$SCRIPTS_DIR" ]; then
    echo "错误：找不到脚本目录: $SCRIPTS_DIR"
    echo "项目根目录: $PROJECT_ROOT"
    exit 1
fi

# 显示使用帮助
show_help() {
    cat << EOF
Java Harness 脚本管理系统

用法: harness <命令> [参数]

可用命令分类：
  build      - 构建相关脚本
  test       - 测试相关脚本
  ci         - CI/CD 相关脚本
  project    - 项目管理脚本
  session    - 会话管理脚本
  plan       - 计划管理脚本
  review     - 审查相关脚本
  service    - 服务管理脚本
  util       - 工具脚本
  verify     - 验证脚本

具体命令：
  build              - 构建项目
  compile            - 编译项目
  clean              - 清理构建
  package            - 打包项目
  test               - 运行测试
  run-tests          - 运行所有测试
  test-integration   - 运行集成测试
  session-init       - 初始化会话
  session-monitor    - 监控会话
  plan-registry      - 管理计划注册
  review-summary     - 生成审查摘要
  code-quality       - 运行代码质量检查

示例：
  harness build
  harness test --help
  harness session-init --project myproject
  harness plan-registry list

要查看具体命令的帮助，使用：
  harness <命令> --help

EOF
}

# 如果没有参数，显示帮助
if [ $# -eq 0 ]; then
    show_help
    exit 0
fi

# 处理帮助命令
if [ "$1" = "help" ] || [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    show_help
    exit 0
fi

# 查找并执行对应的脚本
COMMAND="$1"
shift
ARGS="$@"

# 在各个分类目录中查找脚本
for category in build test ci project session plan review service util verify; do
    script_file="$SCRIPTS_DIR/$category/$COMMAND.sh"
    if [ -f "$script_file" ]; then
        # 找到脚本，执行它
        bash "$script_file" $ARGS
        exit $?
    fi
done

# 如果没有找到，尝试直接名称
script_file="$SCRIPTS_DIR/util/$COMMAND.sh"
if [ -f "$script_file" ]; then
    bash "$script_file" $ARGS
    exit $?
fi

# 如果还是没有找到，显示错误
echo "错误：未找到命令 '$COMMAND'"
echo ""
echo "可用命令："
echo "  build, compile, clean, package"
echo "  test, run-tests, test-integration"
echo "  session-init, session-monitor"
echo "  plan-registry, plans-watcher"
echo "  review-summary, code-quality"
echo ""
echo "使用 'harness help' 查看完整帮助"
exit 1